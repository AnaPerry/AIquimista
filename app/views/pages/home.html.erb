
<div class="container-fluid">
  <div class="row">
    <!-- COLUNA DA SIDEBAR -->
    <div class="col-1">
      SIDEBAR
    </div>

    <!-- COLUNA DO CONTEÚDO -->
    <div class="col-11">
      <div class="card text-center border-0 hero-banner">
        <%= image_tag "AIquimista_logo.jpeg", class: "card-img hero-image" %>
        <div class="card-img-overlay d-flex align-items-center justify-content-center">
          <div>
            <h2>Bem-vindo ao</h2>
            <h1 class="display-2 fw-bold">
              AIquimista
            </h1>
            <p class="fs-4">
              Sabedoria ancestral, insights digitais
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- SESSAO CARTA DO DIA -->

<div class="container my-5">
  <div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4">
      <div class="row align-items-center">

        <!-- COLUNA DA CARTA -->
        <div class="col-12 col-md-4 text-center mb-4 mb-md-0">
          <div class="card tarot-card mx-auto">
            <div class="tarot-card-placeholder">
              IMAGEM DA CARTA
            </div>
          </div>
        </div>

        <!-- COLUNA DO TEXTO -->
        <div class="col-12 col-md-8">
          <p class="text-uppercase fw-bold">
            Carta do dia
          </p>
          <h2 class="fw-bold">
            O Tolo
          </h2>
          <p>
            Novos começos • Liberdade • Espontaneidade
          </p>
          <p>
            Hoje é um convite para confiar no desconhecido e abraçar o novo.
          </p>
          <p>
            Permita-se dar um passo à frente com leveza, sem medo de errar.
          </p>
          <p>
            A jornada é tão importante quanto o destino.
          </p>

          <button class="btn btn-outline-warning">
            Fazer uma leitura
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
