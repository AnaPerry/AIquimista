<div class="container-fluid p-0">
  <div class="row g-0">
    <div class="col-10 reading-form-section">
      <div class="card reading-form-card border-0 shadow-sm">
        <div class="card-body p-5">
          <div class="daily-card-label justify-content-center">
            <span></span>
            <p class="mb-0">Nova leitura</p>
            <span></span>
          </div>

          <%= simple_form_for(@reading) do |f| %>
            <%= f.input :subject,collection: [["Amor", "amor"], ["Carreira", "carreira"]],
                label: "Sobre o que é a leitura?",
                include_blank: "Escolha o tema" %>
            <%= f.association :deck, label: "Baralho", include_blank: "Escolha um baralho" %>
            <%= f.input :style, collection: [["3 cartas", "3"], ["6 cartas", "6"], ["10 cartas", "10"]], label: "Tipo de tiragem", include_blank: "Escolha a tiragem" %>

            <div class="reading-divider d-flex justify-content-center">
              <span></span>
            </div>
            <div class="d-flex justify-content-center">
              <%= f.submit "Criar leitura", class: "btn reading-button" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
