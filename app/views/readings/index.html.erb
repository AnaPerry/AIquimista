<div class="readings-index">
  <div class="container-fluid">
    <div class="daily-card-label">
      <span></span>
      <p class="mb-0">Suas leituras</p>
      <span></span>
    </div>

    <div class="d-flex justify-content-between align-items-center flex-wrap">
      <h1 class="tarot-card-title mb-0">Histórico</h1>
      <%= link_to "Nova leitura", new_reading_path, class: "btn reading-button" %>
    </div>

    <div class="reading-divider">
      <span></span>
    </div>

    <% if @readings.any? %>
      <div class="row">
        <% @readings.each do |reading| %>
          <div class="col-12 col-md-6 col-lg-4 mb-4">
            <div class="card reading-card border-0 shadow-sm h-100">
              <div class="card-body p-4">
                <p class="reading-card-date">
                  <%= reading.created_at.strftime("%d/%m/%Y às %H:%M") %>
                </p>

                <h2 class="reading-card-subject"><%= reading.subject %></h2>

                <p class="reading-card-meta">
                  <%= reading.style %> cartas · <%= reading.deck.name %>
                </p>

                <div class="d-flex gap-2 mt-3">
                  <%= link_to "Ver leitura", reading_path(reading), class: "btn reading-button" %>
                  <%= link_to reading_path(reading),
                      data: { turbo_method: :delete, turbo_confirm: "Apagar esta leitura?" },
                      class: "btn reading-delete-button" do %>
                    <i class="fa-solid fa-trash"></i>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="readings-empty">Você ainda não fez nenhuma leitura.</p>
      <%= link_to "Fazer a primeira", new_reading_path, class: "btn reading-button" %>
    <% end %>
  </div>
</div>
